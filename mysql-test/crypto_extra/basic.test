SELECT HEX(DIGEST('abc', 'sha256'));
SELECT HEX(DIGEST('abc', 'sha3-256'));
SELECT HEX(HMAC('what do ya want for nothing?', 'Jefe', 'sha256'));
SELECT HEX(PBKDF2_HMAC('password', 'salt', 1, 32, 'sha256'));
SELECT LENGTH(GEN_RANDOM_BYTES(32));
SELECT LENGTH(RANDOM_BYTES_HEX(32)),
       RANDOM_BYTES_HEX(32) REGEXP '^[0-9A-F]{64}$';
SET @argon2_hash= ARGON2ID_HASH('password', 1024, 1, 1, 16);
SELECT @argon2_hash LIKE '$argon2id$v=19$m=1024,t=1,p=1$%';
SELECT ARGON2ID_VERIFY('password', @argon2_hash);
SELECT ARGON2ID_VERIFY('wrong password', @argon2_hash);
SELECT ARGON2ID_VERIFY('password', '$argon2id$invalid');
SELECT CRYPTO_EQUALS(DIGEST('abc', 'sha256'), DIGEST('abc', 'sha256'));
SELECT CRYPTO_EQUALS(DIGEST('abc', 'sha256'), DIGEST('abd', 'sha256'));

SET @key= UNHEX('000102030405060708090A0B0C0D0E0F');
SET @iv= UNHEX('101112131415161718191A1B1C1D1E1F');
SET @encrypted= CRYPTO_ENCRYPT_IV('secret', @key, 'aes-128-cbc', @iv);
SELECT HEX(CRYPTO_DECRYPT_IV(@encrypted, @key, 'aes-128-cbc', @iv));
SET @encrypted= CRYPTO_ENCRYPT_IV(REPEAT('x', 16), @key,
                                  'aes-128-cbc/pad:none', @iv);
SELECT LENGTH(@encrypted),
       CRYPTO_DECRYPT_IV(@encrypted, @key, 'aes-128-cbc/pad:none', @iv)
         = REPEAT('x', 16);
SELECT DIGEST(NULL, 'sha256') IS NULL;
SELECT DIGEST('abc', 'no-such-digest') IS NULL;
SELECT CRYPTO_ENCRYPT('secret', @key, 'aes-256-gcm') IS NULL;
